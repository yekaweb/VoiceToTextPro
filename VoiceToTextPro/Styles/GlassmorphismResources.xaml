<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════════════════
         🎨 VoiceToText Pro — macOS Glass Design System v3.0
         Based on: macos_minimal_dark_glass_concept reference images
         ════════════════════════════════════════════════════════════════════ -->

    <!-- ══ COLOR TOKENS (Exact match to concept images) ══ -->

    <!-- Backgrounds -->
    <Color x:Key="MacBgDark">#0F1117</Color>
    <Color x:Key="MacBgSidebar">#161B27</Color>
    <Color x:Key="MacBgCard">#1C2333</Color>
    <Color x:Key="MacBgHeader">#111622</Color>
    <Color x:Key="MacBgInput">#1A2030</Color>
    <Color x:Key="MacBgHover">#1E2736</Color>
    <Color x:Key="MacBgSelected">#253045</Color>
    <Color x:Key="MacBgDownloading">#082F49</Color>
    <Color x:Key="MacBgInstalled">#0D281E</Color>

    <!-- Accent Colors -->
    <Color x:Key="MacPurple">#A855F7</Color>
    <Color x:Key="MacCyan">#06B6D4</Color>
    <Color x:Key="MacGreen">#10B981</Color>
    <Color x:Key="MacRed">#EF4444</Color>
    <Color x:Key="MacBlue">#0EA5E9</Color>
    <Color x:Key="MacAmber">#F59E0B</Color>
    <Color x:Key="MacIndigo">#6366F1</Color>

    <!-- Text Colors -->
    <Color x:Key="MacTextPrimary">#F1F5F9</Color>
    <Color x:Key="MacTextSecondary">#94A3B8</Color>
    <Color x:Key="MacTextMuted">#64748B</Color>
    <Color x:Key="MacTextDisabled">#475569</Color>

    <!-- Borders (Glass effect) -->
    <Color x:Key="MacBorderGlass">#26334D</Color>
    <Color x:Key="MacBorderActive">#A855F7</Color>
    <Color x:Key="MacBorderGreen">#10B981</Color>
    <Color x:Key="MacBorderBlue">#0EA5E9</Color>

    <!-- ══ SOLID BRUSHES ══ -->
    <SolidColorBrush x:Key="MacBgDarkBrush" Color="#0F1117"/>
    <SolidColorBrush x:Key="MacDarkBgBrush" Color="#0F1117"/>
    <SolidColorBrush x:Key="MacSidebarBgBrush" Color="#161B27"/>
    <SolidColorBrush x:Key="MacBgSidebarBrush" Color="#161B27"/>
    <SolidColorBrush x:Key="MacCardBgBrush" Color="#1C2333"/>
    <SolidColorBrush x:Key="MacBgCardBrush" Color="#1C2333"/>
    <SolidColorBrush x:Key="MacHeaderBgBrush" Color="#111622"/>
    <SolidColorBrush x:Key="MacBgHeaderBrush" Color="#111622"/>
    <SolidColorBrush x:Key="MacInputBgBrush" Color="#1A2030"/>
    <SolidColorBrush x:Key="MacBgInputBrush" Color="#1A2030"/>
    <SolidColorBrush x:Key="MacHoverBrush" Color="#1E2736"/>
    <SolidColorBrush x:Key="MacSelectedBrush" Color="#253045"/>

    <SolidColorBrush x:Key="MacPurpleBrush" Color="#A855F7"/>
    <SolidColorBrush x:Key="MacCyanBrush" Color="#06B6D4"/>
    <SolidColorBrush x:Key="MacGreenBrush" Color="#10B981"/>
    <SolidColorBrush x:Key="MacRedBrush" Color="#EF4444"/>
    <SolidColorBrush x:Key="MacBlueBrush" Color="#0EA5E9"/>
    <SolidColorBrush x:Key="MacAmberBrush" Color="#F59E0B"/>

    <SolidColorBrush x:Key="MacTextPrimaryBrush" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="MacTextSecondaryBrush" Color="#94A3B8"/>
    <SolidColorBrush x:Key="MacTextMutedBrush" Color="#64748B"/>

    <SolidColorBrush x:Key="MacGlassBorderBrush" Color="#26334D"/>
    <SolidColorBrush x:Key="MacGlassBgBrush" Color="#1C2333"/>

    <!-- macOS Window Chrome Traffic Light Brushes -->
    <SolidColorBrush x:Key="MacCloseRedBrush" Color="#FF5F57"/>
    <SolidColorBrush x:Key="MacMinimizeYellowBrush" Color="#FFBD2E"/>
    <SolidColorBrush x:Key="MacMaximizeGreenBrush" Color="#28C840"/>

    <!-- Legacy aliases (backward compat) -->

    <!-- ══ GRADIENT BRUSHES ══ -->

    <!-- Purple → Cyan accent gradient (waveform, logo, pills) -->
    <LinearGradientBrush x:Key="MacAccentGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#A855F7" Offset="0"/>
        <GradientStop Color="#7C3AED" Offset="0.4"/>
        <GradientStop Color="#06B6D4" Offset="1"/>
    </LinearGradientBrush>

    <!-- Purple → Cyan vertical (for buttons) -->
    <LinearGradientBrush x:Key="MacPillGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#8B5CF6" Offset="0"/>
        <GradientStop Color="#06B6D4" Offset="1"/>
    </LinearGradientBrush>

    <!-- Red glow for Stop button -->
    <LinearGradientBrush x:Key="MacRedGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#DC2626" Offset="0"/>
        <GradientStop Color="#EF4444" Offset="1"/>
    </LinearGradientBrush>

    <!-- Microphone neon circle (Raycast widget) -->
    <RadialGradientBrush x:Key="MacMicGlowBrush">
        <GradientStop Color="#7C3AED" Offset="0"/>
        <GradientStop Color="#4C1D95" Offset="0.6"/>
        <GradientStop Color="#2D1B69" Offset="1"/>
    </RadialGradientBrush>

    <!-- ══ EFFECTS ══ -->

    <!-- Neon purple glow — for waveform and mic button -->
    <DropShadowEffect x:Key="MacNeonGlowEffect"
                      Color="#A855F7"
                      BlurRadius="20"
                      ShadowDepth="0"
                      Opacity="0.75"/>

    <!-- Red glow — for Stop button -->
    <DropShadowEffect x:Key="MacRedGlowEffect"
                      Color="#EF4444"
                      BlurRadius="18"
                      ShadowDepth="0"
                      Opacity="0.8"/>

    <!-- Cyan glow — for active/running state -->
    <DropShadowEffect x:Key="MacCyanGlowEffect"
                      Color="#06B6D4"
                      BlurRadius="16"
                      ShadowDepth="0"
                      Opacity="0.6"/>

    <!-- Green glow — Installed models / success -->
    <DropShadowEffect x:Key="MacGreenGlowEffect"
                      Color="#10B981"
                      BlurRadius="12"
                      ShadowDepth="0"
                      Opacity="0.5"/>

    <!-- Card elevation shadow -->
    <DropShadowEffect x:Key="MacCardShadow"
                      Color="#000000"
                      BlurRadius="24"
                      ShadowDepth="4"
                      Opacity="0.5"/>

    <!-- ══ BUTTON STYLES ══ -->

    <!-- Pill accent button (Purple→Cyan gradient) — Primary action -->
    <Style x:Key="MacPillButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource MacPillGradientBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="20,10"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="20"
                            Padding="{TemplateBinding Padding}"
                            Effect="{DynamicResource MacNeonGlowEffect}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.88"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.75"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Red Glow Stop pill button -->
    <Style x:Key="MacRedGlowButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource MacRedGradientBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="20,10"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="20"
                            Padding="{TemplateBinding Padding}"
                            Effect="{DynamicResource MacRedGlowEffect}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.70"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Ghost button (border only) -->
    <Style x:Key="MacGhostButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource MacTextSecondaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource MacGlassBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource MacHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.7"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- macOS Traffic Light Close (Red) -->
    <Style x:Key="MacTrafficRedStyle" TargetType="Button">
        <Setter Property="Width" Value="13"/>
        <Setter Property="Height" Value="13"/>
        <Setter Property="Background" Value="#FF5F57"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Ellipse x:Name="Dot" Fill="{TemplateBinding Background}"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Dot" Property="Fill" Value="#FF3B30"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- macOS Traffic Light Minimize (Yellow) -->
    <Style x:Key="MacTrafficYellowStyle" TargetType="Button">
        <Setter Property="Width" Value="13"/>
        <Setter Property="Height" Value="13"/>
        <Setter Property="Background" Value="#FFBD2E"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Ellipse x:Name="Dot" Fill="{TemplateBinding Background}"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Dot" Property="Fill" Value="#FFA500"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- macOS Traffic Light Maximize (Green) -->
    <Style x:Key="MacTrafficGreenStyle" TargetType="Button">
        <Setter Property="Width" Value="13"/>
        <Setter Property="Height" Value="13"/>
        <Setter Property="Background" Value="#28C840"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Ellipse x:Name="Dot" Fill="{TemplateBinding Background}"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Dot" Property="Fill" Value="#1CAD35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Glass Card Style (for use as Panel/Card background) -->
    <Style x:Key="MacGlassCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource MacCardBgBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource MacGlassBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Effect" Value="{DynamicResource MacCardShadow}"/>
    </Style>

    <!-- Status Badge (pill) — model states -->
    <Style x:Key="MacStatusBadgeInstalled" TargetType="Border">
        <Setter Property="Background" Value="#0D2D1E"/>
        <Setter Property="BorderBrush" Value="#10B981"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="8,2"/>
    </Style>

    <Style x:Key="MacStatusBadgeDownloading" TargetType="Border">
        <Setter Property="Background" Value="#082F49"/>
        <Setter Property="BorderBrush" Value="#0EA5E9"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="8,2"/>
    </Style>

    <Style x:Key="MacStatusBadgeAvailable" TargetType="Border">
        <Setter Property="Background" Value="#1C2333"/>
        <Setter Property="BorderBrush" Value="#475569"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="8,2"/>
    </Style>

    <Style x:Key="MacStatusBadgeUpdate" TargetType="Border">
        <Setter Property="Background" Value="#2A1B08"/>
        <Setter Property="BorderBrush" Value="#F59E0B"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="8,2"/>
    </Style>

</ResourceDictionary>
