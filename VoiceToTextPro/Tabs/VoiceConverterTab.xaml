<UserControl x:Class="VoiceToTextPro.Tabs.VoiceConverterTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1100">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- Header Banner -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content Area -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══ Header Banner (macOS Dark Glass Card) ══ -->
        <Border Grid.Row="0" Style="{DynamicResource MacGlassCardStyle}" Padding="16,12" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                        <materialDesign:PackIcon Kind="RecordRec" Width="24" Height="24" Foreground="#A855F7" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{DynamicResource Tab_V2V_Title}" FontSize="18" FontWeight="Bold" Foreground="#F1F5F9" VerticalAlignment="Center"/>
                        <Border Background="#F59E0B" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center" ToolTip="بخش آزمایشگاهی (در حال توسعه و تکمیل)">
                            <TextBlock Text="BETA" FontSize="10" FontWeight="Black" Foreground="#000000"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{DynamicResource Tab_V2V_SubTitle}" FontSize="12" Foreground="#94A3B8" Margin="32,0,0,0"/>
                </StackPanel>

                <!-- Status Badge -->
                <Border Grid.Column="1" Background="#0D2D1E" BorderBrush="#10B981" BorderThickness="1" CornerRadius="16" Padding="12,5" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ShieldCheck" Width="16" Height="16" Foreground="#10B981" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Offline AI Voice Engine" FontSize="11" FontWeight="SemiBold" Foreground="#10B981" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ══ Main Content Grid (Zero-Scroll Proportional Grid) ══ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Controls Sidebar (Left) -->
                <ColumnDefinition Width="380"/>
                <!-- Dual Player Studio (Right) -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ══ Left Panel: Voice Controls Studio ══ -->
            <Border Grid.Column="0" Style="{DynamicResource MacGlassCardStyle}" Padding="16" Margin="0,0,12,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Vertical">
                        
                        <!-- 1. Source Audio File Dropzone -->
                        <TextBlock Text="۱. انتخاب فایل صوتی ورودی (Source)" FontSize="13" FontWeight="Bold" Foreground="#F1F5F9" Margin="0,0,0,8"/>
                        
                        <Border x:Name="AudioDropZone" AllowDrop="True" Drop="AudioDropZone_Drop" MouseLeftButtonDown="AudioDropZone_Click"
                                Background="#1A2030" BorderBrush="#A855F7" BorderThickness="1.5" 
                                CornerRadius="10" Padding="14,12" Cursor="Hand" Margin="0,0,0,14">
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="CloudUpload" Width="32" Height="32" Foreground="#A855F7" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                <TextBlock x:Name="DropZoneFileNameText" Text="فایل صوتی را بکشید و رها کنید" FontSize="12" FontWeight="SemiBold" Foreground="#F1F5F9" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                                <TextBlock x:Name="DropZoneSubText" Text="کلیک برای انتخاب (WAV, MP3, M4A, FLAC, OGG)" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- 2. Target Voice Speaker Profile -->
                        <TextBlock Text="۲. انتخاب گوینده هدف (Target Voice)" FontSize="13" FontWeight="Bold" Foreground="#F1F5F9" Margin="0,0,0,8"/>
                        
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="VoiceProfileComboBox" Grid.Column="0" 
                                      Background="#1A2030" Foreground="#F1F5F9" BorderBrush="#26334D"
                                      Style="{DynamicResource MaterialDesignOutlinedComboBox}" 
                                      DisplayMemberPath="Name" SelectedValuePath="FilePath" VerticalAlignment="Center" Height="40"/>
                            <Button Grid.Column="1" Click="RecordProfile_Click" Style="{DynamicResource MacGhostButtonStyle}" Height="38" Padding="10,0" ToolTip="ضبط پروفایل صوتی جدید با میکروفون" Margin="6,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Microphone" Width="14" Height="14" Foreground="#A855F7" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Text="ضبط جدید" FontSize="11" Foreground="#F1F5F9" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2" Click="RefreshProfiles_Click" Style="{DynamicResource MacGhostButtonStyle}" Width="38" Height="38" Padding="0" ToolTip="به‌روزرسانی لیست گویندگان" Margin="4,0,0,0">
                                <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" Foreground="#94A3B8"/>
                            </Button>
                        </Grid>

                        <!-- 3. Fine-Tuning Controls -->
                        <Border Background="#161B27" BorderBrush="#26334D" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,14">
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="۳. تنظیمات دقیق تغییر صدا" FontSize="12" FontWeight="Bold" Foreground="#06B6D4" Margin="0,0,0,10"/>

                                <!-- Pitch Shift Slider -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="تغییر گام صدا (Pitch Shift):" FontSize="11" Foreground="#94A3B8"/>
                                    <TextBlock x:Name="PitchValueText" Grid.Column="1" Text="0 نیم‌گام (طبیعی)" FontSize="11" FontWeight="Bold" Foreground="#A855F7"/>
                                </Grid>
                                <Slider x:Name="PitchSlider" Minimum="-12" Maximum="12" Value="0" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="PitchSlider_ValueChanged" Margin="0,0,0,10"/>

                                <!-- Accent Retention Slider -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="حفظ ریتم و منحنی لحن:" FontSize="11" Foreground="#94A3B8"/>
                                    <TextBlock x:Name="AccentValueText" Grid.Column="1" Text="100%" FontSize="11" FontWeight="Bold" Foreground="#06B6D4"/>
                                </Grid>
                                <Slider x:Name="AccentSlider" Minimum="0" Maximum="100" Value="100" ValueChanged="AccentSlider_ValueChanged" Margin="0,0,0,10"/>

                                <!-- Denoise Toggle -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock Text="کاهش نویز پس‌زمینه (Denoise)" FontSize="11" FontWeight="SemiBold" Foreground="#F1F5F9"/>
                                        <TextBlock Text="حذف نویز قبل از تبدیل" FontSize="10" Foreground="#94A3B8"/>
                                    </StackPanel>
                                    <ToggleButton x:Name="DenoiseToggle" Grid.Column="1" IsChecked="True" Style="{DynamicResource MaterialDesignSwitchToggleButton}" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Convert Button & Status -->
                        <Button x:Name="ConvertVoiceBtn" Click="ConvertVoiceBtn_Click" Height="44" Style="{DynamicResource MacPillButtonStyle}" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AutoFix" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="⚡ شروع تبدیل هوشمند صدا (Convert)" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <ProgressBar x:Name="ConvertProgressBar" Height="4" IsIndeterminate="False" Value="0" Margin="0,0,0,6" Visibility="Collapsed" Foreground="#A855F7"/>
                        <TextBlock x:Name="StatusText" Text="آماده تبدیل فایل صوتی" FontSize="11" Foreground="#94A3B8" TextAlignment="Center"/>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ══ Right Panel: Dual Player Studio ══ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <!-- Source Audio Card (A) -->
                    <RowDefinition Height="*"/>
                    <!-- Converted Audio Card (B) -->
                    <RowDefinition Height="*"/>
                    <!-- Ethical Consent Banner -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Source Audio Player Card (A) -->
                <Border Grid.Row="0" Style="{DynamicResource MacGlassCardStyle}" Padding="16" Margin="0,0,0,8" BorderBrush="#0EA5E9">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <materialDesign:PackIcon Kind="MusicNote" Width="18" Height="18" Foreground="#0EA5E9" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="فایل صوتی ورودی (Source Audio - A)" FontSize="13" FontWeight="Bold" Foreground="#F1F5F9"/>
                        </StackPanel>

                        <!-- Source Waveform Display -->
                        <Border Grid.Row="1" Background="#161B27" BorderBrush="#26334D" BorderThickness="1" CornerRadius="10" Padding="12" VerticalAlignment="Stretch">
                            <Grid VerticalAlignment="Center">
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                    <materialDesign:PackIcon Kind="Waveform" Width="42" Height="42" Foreground="#0EA5E9" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                    <TextBlock x:Name="SourceAudioInfoText" Text="هیچ فایلی انتخاب نشده است" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Source Playback Controls -->
                        <Grid Grid.Row="2" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="SourcePlayBtn" Click="SourcePlayBtn_Click" Style="{DynamicResource MacGhostButtonStyle}" Width="36" Height="36" Padding="0" IsEnabled="False">
                                <materialDesign:PackIcon x:Name="SourcePlayIcon" Kind="Play" Width="20" Height="20" Foreground="#0EA5E9"/>
                            </Button>

                            <Slider x:Name="SourceSeekSlider" Grid.Column="1" VerticalAlignment="Center" IsEnabled="False" Margin="10,0" ValueChanged="SourceSeekSlider_ValueChanged"/>

                            <TextBlock x:Name="SourceTimeText" Grid.Column="2" Text="00:00 / 00:00" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Converted Audio Player Card (B) -->
                <Border Grid.Row="1" Style="{DynamicResource MacGlassCardStyle}" Padding="16" Margin="0,4,0,8" BorderBrush="#10B981">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AccountVoice" Width="18" Height="18" Foreground="#10B981" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="صدای خروجی تبدیل‌شده (Converted Audio - B)" FontSize="13" FontWeight="Bold" Foreground="#F1F5F9"/>
                            </StackPanel>

                            <Button x:Name="ExportWavBtn" Grid.Column="1" Click="ExportWavBtn_Click" Style="{DynamicResource MacGhostButtonStyle}" Height="30" Padding="12,0" IsEnabled="False">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Download" Width="14" Height="14" Foreground="#10B981" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="ذخیره WAV" FontSize="11" Foreground="#10B981"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Converted Waveform Display -->
                        <Border Grid.Row="1" Background="#161B27" BorderBrush="#26334D" BorderThickness="1" CornerRadius="10" Padding="12" VerticalAlignment="Stretch">
                            <Grid VerticalAlignment="Center">
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                    <materialDesign:PackIcon x:Name="ConvertedStatusIcon" Kind="Equalizer" Width="42" Height="42" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                    <TextBlock x:Name="ConvertedAudioInfoText" Text="پس از کلیک روی دکمه تبدیل، خروجی در اینجا آماده پخش می‌شود" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Converted Playback Controls -->
                        <Grid Grid.Row="2" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="ConvertedPlayBtn" Click="ConvertedPlayBtn_Click" Style="{DynamicResource MacGhostButtonStyle}" Width="36" Height="36" Padding="0" IsEnabled="False">
                                <materialDesign:PackIcon x:Name="ConvertedPlayIcon" Kind="Play" Width="20" Height="20" Foreground="#10B981"/>
                            </Button>

                            <Slider x:Name="ConvertedSeekSlider" Grid.Column="1" VerticalAlignment="Center" IsEnabled="False" Margin="10,0" ValueChanged="ConvertedSeekSlider_ValueChanged"/>

                            <TextBlock x:Name="ConvertedTimeText" Grid.Column="2" Text="00:00 / 00:00" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Ethical Consent Banner -->
                <Border Grid.Row="2" Background="#161B27" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,4,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Kind="AlertCircleOutline" Width="16" Height="16" Foreground="#F59E0B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Grid.Column="1" Text="بیانیه اخلاقی: استفاده از سیستم شبیه‌سازی صدا تنها با رضایت صاحبان گوینده مجاز می‌باشد." FontSize="11" Foreground="#F1F5F9" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
