<UserControl x:Class="VoiceToTextPro.Tabs.DownloaderTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             FontFamily="{StaticResource IranSansFont}"
             Foreground="#E2E8F0">

    <!-- ══ Root Workspace Grid: Concept Match ══ -->
    <Grid Margin="20,10,20,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header & Platform Badges -->
            <RowDefinition Height="Auto"/> <!-- Link Input Pill Card -->
            <RowDefinition Height="Auto"/> <!-- Discovered Media Info -->
            <RowDefinition Height="Auto"/> <!-- Download Progress Bar -->
            <RowDefinition Height="*"/>    <!-- Downloaded Media Gallery -->
        </Grid.RowDefinitions>

        <!-- 1. Header & Supported Platforms -->
        <Border Grid.Row="0" Background="#151B26" BorderBrush="{StaticResource MacGlassBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="14,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="{DynamicResource Downloader_Title}" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,6"/>
                    <WrapPanel x:Name="PluginChipsPanel">
                        <Border Background="#2A1B36" BorderBrush="#A855F7" BorderThickness="1" CornerRadius="12" Padding="8,3" Margin="0,0,6,0">
                            <TextBlock Text="▶️ YouTube" Foreground="#D8B4FE" FontWeight="Bold" FontSize="11"/>
                        </Border>
                        <Border Background="#331A29" BorderBrush="#EC4899" BorderThickness="1" CornerRadius="12" Padding="8,3" Margin="0,0,6,0">
                            <TextBlock Text="📸 Instagram" Foreground="#F472B6" FontWeight="Bold" FontSize="11"/>
                        </Border>
                        <Border Background="#132B27" BorderBrush="#10B981" BorderThickness="1" CornerRadius="12" Padding="8,3" Margin="0,0,6,0">
                            <TextBlock Text="🎵 TikTok" Foreground="#34D399" FontWeight="Bold" FontSize="11"/>
                        </Border>
                    </WrapPanel>
                </StackPanel>

                <!-- Auto Detection Badge -->
                <Border Grid.Column="1" x:Name="DetectedPlatformBadge" Background="#1E2736" CornerRadius="12" Padding="10,4" VerticalAlignment="Center" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Platform: " Foreground="#94A3B8" FontSize="11"/>
                        <TextBlock x:Name="DetectedPlatformText" Text="YouTube" Foreground="#38BDF8" FontWeight="Bold" FontSize="11"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 2. Link Input & Action Buttons -->
        <Border Grid.Row="1" Background="#151B26" BorderBrush="{StaticResource MacGlassBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="14,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="UrlInput" Grid.Column="0" TextChanged="UrlInput_TextChanged"
                         Background="#1B2332" Foreground="#FFFFFF" FontSize="12.5" BorderThickness="1" BorderBrush="{StaticResource MacGlassBorderBrush}"
                         Padding="12,8" Height="38" Margin="0,0,12,0"
                         materialDesign:HintAssist.Hint="{DynamicResource Downloader_UrlHint}" materialDesign:HintAssist.Foreground="#64748B"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Click="FetchInfo_Click" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="#38BDF8" BorderBrush="#334155" Height="38" Padding="12,0" Margin="0,0,8,0" FontSize="11.5">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Search" Margin="0,0,6,0" VerticalAlignment="Center" Width="16" Height="16"/>
                            <TextBlock Text="{DynamicResource Downloader_QualityOptionsBtn}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Click="DirectDownload_Click" Style="{StaticResource MacPillButtonStyle}" Height="38" Padding="16,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Flash" Margin="0,0,6,0" VerticalAlignment="Center" Width="16" Height="16"/>
                            <TextBlock Text="{DynamicResource Downloader_DownloadBtn}" VerticalAlignment="Center" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. Discovered Media Info -->
        <Border x:Name="MediaInfoCard" Grid.Row="2" Background="#151B26" BorderBrush="#06B6D4" BorderThickness="1" CornerRadius="14" Padding="14,10" Margin="0,0,0,12" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Background="#1E2736" CornerRadius="8" Width="72" Height="72" Margin="0,0,12,0" ClipToBounds="True">
                    <Image x:Name="ThumbnailImage" Stretch="UniformToFill"/>
                </Border>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="MediaTitleText" Text="{DynamicResource Downloader_VideoTitlePlaceholder}" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" TextWrapping="Wrap"/>
                    <TextBlock x:Name="MediaUploaderText" Grid.Row="1" Text="{DynamicResource Downloader_UploaderPlaceholder}" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,8"/>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{DynamicResource Downloader_QualityLabel}" FontSize="11" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="0,0,8,0"/>

                        <ComboBox x:Name="QualityCombo" Grid.Column="1" Background="#1E2736" Foreground="White" Height="32" Padding="8,4" FontSize="11" Margin="0,0,12,0"/>

                        <CheckBox x:Name="AudioOnlyCheck" Grid.Column="2" Content="{DynamicResource Downloader_ExtractAudioCheck}" Foreground="#CBD5E1" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0"/>

                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="DownloadBtn" Click="Download_Click" Style="{StaticResource MacPillButtonStyle}" Height="32" Padding="12,0" Margin="0,0,6,0">
                                <TextBlock Text="{DynamicResource Downloader_StartBtn}" VerticalAlignment="Center"/>
                            </Button>
                            
                            <Button x:Name="StopDownloadBtn" Click="StopDownload_Click" IsEnabled="False" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="#EF4444" BorderBrush="#EF4444" Height="32" Padding="10,0">
                                <TextBlock Text="{DynamicResource Downloader_StopBtn}" VerticalAlignment="Center"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <!-- 4. Download Progress -->
        <Border Grid.Row="3" Background="#151B26" BorderBrush="{StaticResource MacGlassBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12,8" Margin="0,0,0,12">
            <StackPanel>
                <Grid Margin="0,0,0,4">
                    <TextBlock x:Name="DownloadLogText" Text="{DynamicResource Downloader_LogWaiting}" Foreground="#94A3B8" FontSize="11"/>
                    <TextBlock x:Name="DownloadPercentText" Text="0%" HorizontalAlignment="Right" FontSize="11" FontWeight="Bold" Foreground="#10B981"/>
                </Grid>
                <ProgressBar x:Name="DownloadProgress" Height="5" Minimum="0" Maximum="100" Value="0" Foreground="#10B981" Background="#1E2736"/>
            </StackPanel>
        </Border>

        <!-- 5. Downloaded Media Gallery -->
        <Border Grid.Row="4" Background="#151B26" BorderBrush="{StaticResource MacGlassBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Downloader_GalleryTitle}" FontSize="13.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <Border Background="#1E2736" CornerRadius="10" Padding="8,2" Margin="10,0,0,0">
                            <TextBlock x:Name="GalleryCountText" Text="0 فایل" Foreground="#38BDF8" FontSize="10.5" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>

                    <Button HorizontalAlignment="Right" Click="RefreshGallery_Click" Style="{StaticResource MaterialDesignFlatButton}" Foreground="#38BDF8" Height="26" Padding="6,0" FontSize="11">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Refresh" Margin="0,0,4,0" VerticalAlignment="Center" Width="14" Height="14"/>
                            <TextBlock Text="{DynamicResource Downloader_RefreshBtn}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Gallery List -->
                <ListView x:Name="GalleryListView" Grid.Row="1" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#1A2230" CornerRadius="10" Padding="12" Margin="0,0,0,8" BorderBrush="{StaticResource MacGlassBorderBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Background="#253045" CornerRadius="8" Width="36" Height="36" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding PlatformIcon}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FileName}" FontSize="12.5" FontWeight="Bold" Foreground="#F1F5F9" TextWrapping="Wrap"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <Border Background="#2E3E59" CornerRadius="4" Padding="5,1" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding FileExtension}" Foreground="#38BDF8" FontSize="9.5" FontWeight="Bold"/>
                                            </Border>
                                            <TextBlock Text="{Binding FileSizeFormatted}" Foreground="#94A3B8" FontSize="10" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding DownloadedAt, StringFormat='HH:mm - yyyy/MM/dd'}" Foreground="#64748B" FontSize="10" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Click="SendItemToTranscribe_Click" Tag="{Binding FilePath}" Style="{StaticResource MaterialDesignOutlinedButton}" BorderBrush="#A855F7" Foreground="#D8B4FE" Height="28" Padding="8,0" Margin="0,0,4,0" FontSize="10.5">
                                            <TextBlock Text="{DynamicResource Downloader_TranscribeItemBtn}" VerticalAlignment="Center"/>
                                        </Button>

                                        <Button Click="SendItemToSubtitle_Click" Tag="{Binding FilePath}" Style="{StaticResource MaterialDesignOutlinedButton}" BorderBrush="#10B981" Foreground="#34D399" Height="28" Padding="8,0" Margin="0,0,4,0" FontSize="10.5">
                                            <TextBlock Text="{DynamicResource Downloader_SubtitleItemBtn}" VerticalAlignment="Center"/>
                                        </Button>

                                        <Button Click="PlayMedia_Click" Tag="{Binding FilePath}" Style="{StaticResource MaterialDesignIconButton}" Foreground="#10B981" Width="28" Height="28">
                                            <materialDesign:PackIcon Kind="PlayCircleOutline" Width="16" Height="16"/>
                                        </Button>

                                        <Button Click="ShowInExplorer_Click" Tag="{Binding FilePath}" Style="{StaticResource MaterialDesignIconButton}" Foreground="#38BDF8" Width="28" Height="28">
                                            <materialDesign:PackIcon Kind="FolderOpenOutline" Width="16" Height="16"/>
                                        </Button>

                                        <Button Click="DeleteFile_Click" Tag="{Binding FilePath}" Style="{StaticResource MaterialDesignIconButton}" Foreground="#F87171" Width="28" Height="28">
                                            <materialDesign:PackIcon Kind="DeleteOutline" Width="16" Height="16"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</UserControl>
