<UserControl x:Class="VoiceToTextPro.Tabs.VoiceConverterTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1100">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- Header Banner -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content Area -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══ Header Banner ══ -->
        <Border Grid.Row="0" Background="{DynamicResource MaterialDesignCardBackground}" CornerRadius="12" Padding="16,14" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <materialDesign:PackIcon Kind="RecordRec" Width="26" Height="26" Foreground="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{DynamicResource Tab_V2V_Title}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource MaterialDesignBody}"/>
                    </StackPanel>
                    <TextBlock Text="{DynamicResource Tab_V2V_SubTitle}" FontSize="12" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="34,0,0,0"/>
                </StackPanel>

                <!-- Disclaimer Badge -->
                <Border Grid.Column="1" Background="#1E00E676" BorderBrush="#00E676" BorderThickness="1" CornerRadius="16" Padding="12,6" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ShieldCheck" Width="16" Height="16" Foreground="#00E676" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Offline AI Voice Engine" FontSize="11" FontWeight="SemiBold" Foreground="#00E676" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ══ Main Content Grid ══ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Controls Column (Left) -->
                <ColumnDefinition Width="420"/>
                <!-- Dual Player Column (Right) -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ══ Left Panel: Controls & Dropzone ══ -->
            <Border Grid.Column="0" Background="{DynamicResource MaterialDesignCardBackground}" CornerRadius="12" Padding="16" Margin="0,0,12,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Orientation="Vertical">
                        
                        <!-- Drag and Drop Dropzone -->
                        <TextBlock Text="۱. انتخاب فایل صوتی منبع (Source Audio)" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource MaterialDesignBody}" Margin="0,0,0,8"/>
                        
                        <Border x:Name="AudioDropZone" AllowDrop="True" Drop="AudioDropZone_Drop" MouseLeftButtonDown="AudioDropZone_Click"
                                Background="#0DFFFFFF" BorderBrush="{DynamicResource PrimaryHueMidBrush}" BorderThickness="1.5" 
                                CornerRadius="10" Padding="16" Cursor="Hand" Margin="0,0,0,16">
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="CloudUpload" Width="36" Height="36" Foreground="{DynamicResource PrimaryHueMidBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock x:Name="DropZoneFileNameText" Text="فایل صوتی را بکشید و در اینجا رها کنید" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBody}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                                <TextBlock x:Name="DropZoneSubText" Text="یا برای انتخاب کلیک کنید (WAV, MP3, M4A, FLAC, OGG)" FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Target Voice Profile Picker -->
                        <TextBlock Text="۲. انتخاب گوینده هدف (Target Voice Profile)" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource MaterialDesignBody}" Margin="0,0,0,8"/>
                        
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="VoiceProfileComboBox" Grid.Column="0" Style="{DynamicResource MaterialDesignOutlinedComboBox}" DisplayMemberPath="Name" SelectedValuePath="FilePath" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Click="RecordProfile_Click" Style="{DynamicResource MaterialDesignOutlinedButton}" Height="32" Padding="8,0" ToolTip="ضبط پروفایل صوتی جدید با میکروفون" Margin="6,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Microphone" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Text="ضبط جدید" FontSize="11" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2" Click="RefreshProfiles_Click" Style="{DynamicResource MaterialDesignIconButton}" ToolTip="به‌روزرسانی لیست گویندگان" Margin="4,0,0,0">
                                <materialDesign:PackIcon Kind="Refresh" Width="20" Height="20"/>
                            </Button>
                        </Grid>

                        <!-- Fine-Tuning Controls -->
                        <TextBlock Text="۳. تنظیمات دقیق تغییر صدا" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource MaterialDesignBody}" Margin="0,0,0,12"/>

                        <!-- Pitch Shift Slider -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="تغییر گام صدا (Pitch Shift):" FontSize="12" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                            <TextBlock x:Name="PitchValueText" Grid.Column="1" Text="0 نیم‌گام (طبیعی)" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                        </Grid>
                        <Slider x:Name="PitchSlider" Minimum="-12" Maximum="12" Value="0" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="PitchSlider_ValueChanged" Margin="0,0,0,16"/>

                        <!-- Accent Retention Slider -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="حفظ ریتم و منحنی لحن:" FontSize="12" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                            <TextBlock x:Name="AccentValueText" Grid.Column="1" Text="100%" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                        </Grid>
                        <Slider x:Name="AccentSlider" Minimum="0" Maximum="100" Value="100" ValueChanged="AccentSlider_ValueChanged" Margin="0,0,0,16"/>

                        <!-- Denoise & Blend Controls -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="کاهش نویز پس‌زمینه (Denoising)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBody}"/>
                                <TextBlock Text="حذف نویز صوتی قبل از تبدیل هوشمند" FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                            </StackPanel>
                            <ToggleButton x:Name="DenoiseToggle" Grid.Column="1" IsChecked="True" Style="{DynamicResource MaterialDesignSwitchToggleButton}" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Convert Button & Status -->
                        <Button x:Name="ConvertVoiceBtn" Click="ConvertVoiceBtn_Click" Height="46" Style="{DynamicResource MaterialDesignRaisedButton}" materialDesign:ButtonAssist.CornerRadius="10" Margin="0,8,0,12">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AutoFix" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="⚡ شروع تبدیل هوشمند صدا (Convert Voice)" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <ProgressBar x:Name="ConvertProgressBar" Height="6" IsIndeterminate="False" Value="0" Margin="0,0,0,8" Visibility="Collapsed"/>
                        <TextBlock x:Name="StatusText" Text="آماده تبدیل فایل صوتی" FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}" TextAlignment="Center"/>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ══ Right Panel: Dual A/B Comparison Player ══ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <!-- Source Audio Player Card -->
                    <RowDefinition Height="*"/>
                    <!-- Converted Audio Player Card -->
                    <RowDefinition Height="*"/>
                    <!-- Ethical Consent Banner -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Source Audio Player Card -->
                <Border Grid.Row="0" Background="{DynamicResource MaterialDesignCardBackground}" CornerRadius="12" Padding="16" Margin="0,0,0,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                            <materialDesign:PackIcon Kind="MusicNote" Width="20" Height="20" Foreground="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="فایل صوتی ورودی (Source Audio - A)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource MaterialDesignBody}"/>
                        </StackPanel>

                        <!-- Source Player View / Info -->
                        <Border Grid.Row="1" Background="#0AFFFFFF" CornerRadius="8" Padding="12" VerticalAlignment="Center">
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="Waveform" Width="48" Height="48" Foreground="{DynamicResource PrimaryHueMidBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock x:Name="SourceAudioInfoText" Text="هیچ فایلی انتخاب نشده است" FontSize="12" Foreground="{DynamicResource MaterialDesignBodyLight}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Source Controls -->
                        <Grid Grid.Row="2" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="SourcePlayBtn" Click="SourcePlayBtn_Click" Style="{DynamicResource MaterialDesignIconButton}" IsEnabled="False">
                                <materialDesign:PackIcon x:Name="SourcePlayIcon" Kind="Play" Width="24" Height="24"/>
                            </Button>

                            <Slider x:Name="SourceSeekSlider" Grid.Column="1" VerticalAlignment="Center" IsEnabled="False" Margin="8,0" ValueChanged="SourceSeekSlider_ValueChanged"/>

                            <TextBlock x:Name="SourceTimeText" Grid.Column="2" Text="00:00 / 00:00" FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}" VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Converted Audio Player Card -->
                <Border Grid.Row="1" Background="{DynamicResource MaterialDesignCardBackground}" CornerRadius="12" Padding="16" Margin="0,4,0,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AccountVoice" Width="20" Height="20" Foreground="#00E676" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="صدای خروجی تبدیل‌شده (Converted Audio - B)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource MaterialDesignBody}"/>
                            </StackPanel>

                            <Button x:Name="ExportWavBtn" Grid.Column="1" Click="ExportWavBtn_Click" Style="{DynamicResource MaterialDesignOutlinedButton}" Height="30" Padding="10,0" IsEnabled="False">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Download" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="ذخیره WAV" FontSize="11"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Converted Player View / Info -->
                        <Border Grid.Row="1" Background="#0AFFFFFF" CornerRadius="8" Padding="12" VerticalAlignment="Center">
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                <materialDesign:PackIcon x:Name="ConvertedStatusIcon" Kind="Equalizer" Width="48" Height="48" Foreground="{DynamicResource MaterialDesignBodyLight}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock x:Name="ConvertedAudioInfoText" Text="پس از کلیک روی دکمه تبدیل، خروجی در اینجا آماده پخش می‌شود" FontSize="12" Foreground="{DynamicResource MaterialDesignBodyLight}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Converted Controls -->
                        <Grid Grid.Row="2" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="ConvertedPlayBtn" Click="ConvertedPlayBtn_Click" Style="{DynamicResource MaterialDesignIconButton}" IsEnabled="False">
                                <materialDesign:PackIcon x:Name="ConvertedPlayIcon" Kind="Play" Width="24" Height="24"/>
                            </Button>

                            <Slider x:Name="ConvertedSeekSlider" Grid.Column="1" VerticalAlignment="Center" IsEnabled="False" Margin="8,0" ValueChanged="ConvertedSeekSlider_ValueChanged"/>

                            <TextBlock x:Name="ConvertedTimeText" Grid.Column="2" Text="00:00 / 00:00" FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}" VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Ethical Consent Banner -->
                <Border Grid.Row="2" Background="#0DFFB74D" BorderBrush="#FFB74D" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,4,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Kind="AlertCircleOutline" Width="18" Height="18" Foreground="#FFB74D" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Grid.Column="1" Text="بیانیه اخلاقی: استفاده از سیستم شبیه‌سازی صدا تنها با رضایت صاحبان گوینده مجاز می‌باشد." FontSize="11" Foreground="{DynamicResource MaterialDesignBody}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
