<UserControl x:Class="VoiceToTextPro.Controls.MacWindowControls"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="30" d:DesignWidth="70">
    <UserControl.Resources>
        <!-- Traffic Light Base Button Template -->
        <ControlTemplate x:Key="MacTrafficButtonTemplate" TargetType="Button">
            <Grid x:Name="btnGrid" Background="Transparent">
                <Ellipse x:Name="ellipse" 
                         Width="12" 
                         Height="12" 
                         Fill="{TemplateBinding Background}" 
                         HorizontalAlignment="Center" 
                         VerticalAlignment="Center"/>
                <!-- Micro hover icons (x, -, +) -->
                <TextBlock x:Name="hoverIcon" 
                           Text="{TemplateBinding Content}" 
                           Foreground="#40000000" 
                           FontSize="8" 
                           FontWeight="Bold" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center" 
                           Visibility="Collapsed"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="ellipse" Property="Opacity" Value="0.85"/>
                    <Setter TargetName="hoverIcon" Property="Visibility" Value="Visible"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="ellipse" Property="Opacity" Value="0.6"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </UserControl.Resources>

    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
        <!-- Close Button (Red) -->
        <Button x:Name="CloseBtn" 
                Width="16" Height="16" 
                Margin="0,0,6,0"
                Background="#FF5F57" 
                Content="✕"
                Template="{StaticResource MacTrafficButtonTemplate}"
                Click="CloseBtn_Click"
                ToolTip="بستن پنجره"/>

        <!-- Minimize Button (Yellow) -->
        <Button x:Name="MinimizeBtn" 
                Width="16" Height="16" 
                Margin="0,0,6,0"
                Background="#FFBD2E" 
                Content="─"
                Template="{StaticResource MacTrafficButtonTemplate}"
                Click="MinimizeBtn_Click"
                ToolTip="کوچک‌سازی"/>

        <!-- Maximize / Restore Button (Green) -->
        <Button x:Name="MaximizeBtn" 
                Width="16" Height="16" 
                Background="#28C840" 
                Content="⤢"
                Template="{StaticResource MacTrafficButtonTemplate}"
                Click="MaximizeBtn_Click"
                ToolTip="بزرگ‌سازی"/>
    </StackPanel>
</UserControl>
