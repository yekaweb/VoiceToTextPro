<UserControl x:Class="VoiceToTextPro.Tabs.TranscribeTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             FontFamily="{StaticResource IranSansFont}"
             Foreground="#E2E8F0">

    <!-- ══ Root Workspace Grid: Concept Match ══ -->
    <Grid Margin="20,10,20,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- File & Engine Selectors -->
            <RowDefinition Height="Auto"/> <!-- Action Pill Bar -->
            <RowDefinition Height="*"/>    <!-- Text Output & Waveform Player -->
        </Grid.RowDefinitions>

        <!-- 1. File Selector & Language Card -->
        <Border Grid.Row="0" Background="#151B26" BorderBrush="{StaticResource MacGlassBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="16,12" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="{DynamicResource Transcribe_SelectFileHeader}" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,10"/>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="FilePathBox" Grid.Column="0"
                             Background="#1B2332" Foreground="#FFFFFF" FontSize="12" BorderThickness="1" BorderBrush="{StaticResource MacGlassBorderBrush}"
                             Padding="12,8" Height="38" Margin="0,0,10,0"
                             materialDesign:HintAssist.Hint="{DynamicResource Transcribe_FilePathHint}" materialDesign:HintAssist.Foreground="#64748B"/>

                    <Button Grid.Column="1" Click="Browse_Click" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="#38BDF8" BorderBrush="#334155" Height="38" Padding="14,0" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FolderOpen" Margin="0,0,6,0" VerticalAlignment="Center" Width="16" Height="16"/>
                            <TextBlock Text="{DynamicResource Transcribe_BrowseBtn}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <ComboBox x:Name="LangCombo" Grid.Column="2" Width="150" Background="#1B2332" Foreground="White" Height="38" Padding="8,4" FontSize="11.5" Margin="0,0,10,0">
                        <ComboBoxItem Content="فارسی (fa-IR)" Tag="fa-IR" IsSelected="True"/>
                        <ComboBoxItem Content="English (en-US)" Tag="en-US"/>
                        <ComboBoxItem Content="Chinese (zh-CN)" Tag="zh-CN"/>
                        <ComboBoxItem Content="Russian (ru-RU)" Tag="ru-RU"/>
                        <ComboBoxItem Content="German (de-DE)" Tag="de-DE"/>
                        <ComboBoxItem Content="Turkish (tr-TR)" Tag="tr-TR"/>
                        <ComboBoxItem Content="Spanish (es-ES)" Tag="es-ES"/>
                    </ComboBox>

                    <CheckBox x:Name="TimeStampCheck" Grid.Column="3" Content="SRT Timestamps" IsChecked="True" FontSize="11.5" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                </Grid>
            </Grid>
        </Border>

        <!-- 2. Action Pill Controls & Progress Bar -->
        <Border Grid.Row="1" Background="#151B26" BorderBrush="{StaticResource MacGlassBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="16,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="StartBtn" Click="Start_Click" Style="{StaticResource MacPillButtonStyle}" Height="36" Padding="16,0" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Play" Margin="0,0,6,0" VerticalAlignment="Center" Width="16" Height="16"/>
                            <TextBlock Text="{DynamicResource Transcribe_StartBtn}" VerticalAlignment="Center" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="StopBtn" Click="Stop_Click" IsEnabled="False" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="#EF4444" BorderBrush="#EF4444" Height="36" Padding="12,0" Margin="0,0,16,0">
                        <TextBlock Text="{DynamicResource Transcribe_StopBtn}" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>

                <!-- Progress Bar -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Grid Margin="0,0,0,4">
                        <TextBlock x:Name="ProgressStatusText" Text="{DynamicResource Nav_StatusReady}" FontSize="11" Foreground="#94A3B8"/>
                        <TextBlock x:Name="ProgressPercentText" Text="0%" HorizontalAlignment="Right" FontSize="11" FontWeight="Bold" Foreground="#10B981"/>
                    </Grid>
                    <ProgressBar x:Name="ProgressBarCtrl" Height="5" Minimum="0" Maximum="100" Value="0" Foreground="#10B981" Background="#1E2736"/>
                </StackPanel>

                <!-- Export Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="SendToSubBtn" Click="SendToSub_Click" IsEnabled="False" Style="{StaticResource MaterialDesignOutlinedButton}" BorderBrush="#A855F7" Foreground="#D8B4FE" Height="32" Padding="10,0" Margin="0,0,6,0" FontSize="11">
                        <TextBlock Text="{DynamicResource Transcribe_SendToSubtitleBtn}" VerticalAlignment="Center"/>
                    </Button>
                    <Button Click="SaveTxt_Click" Style="{StaticResource MaterialDesignOutlinedButton}" BorderBrush="#38BDF8" Foreground="#38BDF8" Height="32" Padding="10,0" Margin="0,0,6,0" FontSize="11">
                        <TextBlock Text="{DynamicResource Btn_SaveTxt}"/>
                    </Button>
                    <Button Click="SaveSrt_Click" Style="{StaticResource MaterialDesignOutlinedButton}" BorderBrush="#10B981" Foreground="#34D399" Height="32" Padding="10,0" FontSize="11">
                        <TextBlock Text="{DynamicResource Btn_SaveSrt}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. Text Result Canvas & Audio Player Bar -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Result TextBox Canvas -->
            <Border Grid.Row="0" Background="#151B26" BorderBrush="{StaticResource MacGlassBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="{DynamicResource Transcribe_ResultHeader}" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <Button HorizontalAlignment="Right" Click="CopyText_Click" Style="{StaticResource MaterialDesignFlatButton}" Foreground="#38BDF8" Height="26" Padding="6,0" FontSize="11">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentCopy" Margin="0,0,4,0" VerticalAlignment="Center" Width="14" Height="14"/>
                                <TextBlock Text="{DynamicResource Btn_CopyText}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBox x:Name="ResultTextBox" Grid.Row="1"
                             TextWrapping="Wrap" AcceptsReturn="True"
                             FontSize="14"
                             Foreground="#F1F5F9" Background="Transparent"
                             BorderThickness="0" VerticalScrollBarVisibility="Auto"
                             materialDesign:HintAssist.Hint="{DynamicResource Transcribe_ResultHint}"/>
                </Grid>
            </Border>

            <!-- Waveform Audio Player -->
            <Border Grid.Row="1" Background="#151B26" BorderBrush="{StaticResource MacGlassBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="14,10" Margin="0,12,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="46"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Canvas x:Name="WaveCanvas" Grid.Row="0" Background="#1E2736" ClipToBounds="True" SizeChanged="WaveCanvas_SizeChanged" HorizontalAlignment="Stretch"/>

                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Click="PlayPause_Click" Style="{StaticResource MaterialDesignIconButton}" Foreground="#10B981" Width="30" Height="30">
                                <materialDesign:PackIcon x:Name="PlayIcon" Kind="Play" Width="18" Height="18"/>
                            </Button>
                            <Button Click="StopAudio_Click" Style="{StaticResource MaterialDesignIconButton}" Foreground="#EF4444" Width="30" Height="30" Margin="4,0,0,0">
                                <materialDesign:PackIcon Kind="Stop" Width="18" Height="18"/>
                            </Button>
                        </StackPanel>

                        <TextBlock x:Name="TimeLabel" Grid.Column="1" Text="00:00 / 00:00" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" Margin="12,0"/>

                        <Slider x:Name="SeekSlider" Grid.Column="2" VerticalAlignment="Center" Minimum="0" Maximum="100" ValueChanged="SeekSlider_ValueChanged" Foreground="#A855F7" HorizontalAlignment="Stretch"/>

                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                            <materialDesign:PackIcon Kind="VolumeHigh" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,4,0" Width="16" Height="16"/>
                            <Slider x:Name="VolumeSlider" Width="80" Minimum="0" Maximum="1" Value="0.8" ValueChanged="VolumeSlider_ValueChanged" Foreground="#A855F7"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
