<Window x:Class="VoiceToTextPro.Windows.RaycastWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:VoiceToTextPro.Controls"
        Title="VoiceToText Pro Quick Record" 
        Height="220" Width="840"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Topmost="True"
        ShowInTaskbar="False"
        Background="Transparent"
        FlowDirection="LeftToRight">

    <Window.Resources>
        <!-- ═══ Glass Copy Button Style ═══ -->
        <Style x:Key="GlassCopyBtnStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="copyBorder" 
                                Background="#45A855F7" 
                                BorderBrush="#65E040FB" 
                                BorderThickness="1" 
                                CornerRadius="12" 
                                Padding="12,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="copyBorder" Property="Background" Value="#65A855F7"/>
                                <Setter TargetName="copyBorder" Property="BorderBrush" Value="#95FFFFFF"/>
                                <Setter Property="Cursor" Value="Hand"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="copyBorder" Property="Background" Value="#85A855F7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ Glass Close Button Style ═══ -->
        <Style x:Key="GlassCloseBtnStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="closeBorder" 
                                Background="#28EF4444" 
                                BorderBrush="#45EF4444" 
                                BorderThickness="1" 
                                CornerRadius="11" 
                                Width="22" Height="22">
                            <TextBlock x:Name="closeIcon" Text="✕" 
                                       Foreground="#A0F87171" FontSize="11" FontWeight="Bold" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="closeBorder" Property="Background" Value="#65EF4444"/>
                                <Setter TargetName="closeBorder" Property="BorderBrush" Value="#AAEF4444"/>
                                <Setter TargetName="closeIcon" Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="Cursor" Value="Hand"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="closeBorder" Property="Background" Value="#EF4444"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- ════════════════════════════════════════════════════════════════ -->
    <!--  MAIN OUTER FLOATING CONTAINER — Smoked Glass Multi-Light Surface  -->
    <!-- ════════════════════════════════════════════════════════════════ -->
    <Grid Margin="12">
        <!-- Layer 1: Soft Ambient Outer Shadow -->
        <Border CornerRadius="30" Margin="4">
            <Border.Effect>
                <DropShadowEffect BlurRadius="65" ShadowDepth="16" Direction="270" Color="#000000" Opacity="0.9"/>
            </Border.Effect>
            <Border.Background>
                <SolidColorBrush Color="#01000000"/>
            </Border.Background>
        </Border>

        <!-- Layer 2: Main Smoked Glass Body with Multi-Point Ambient Gradients -->
        <Border x:Name="GlassPanel" CornerRadius="30" 
                BorderThickness="1.5" 
                Padding="24,18,24,18"
                ClipToBounds="True">

            <!-- Base Translucent Smoked Glass Background -->
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#55454552" Offset="0"/>       <!-- Lighter smoked graphite top -->
                    <GradientStop Color="#C5252530" Offset="0.5"/>    <!-- Mid translucent graphite -->
                    <GradientStop Color="#E812101B" Offset="1"/>       <!-- Dark smoked purple-black bottom -->
                </LinearGradientBrush>
            </Border.Background>

            <!-- Translucent Glass Metallic Border -->
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#45FFFFFF" Offset="0"/>
                    <GradientStop Color="#25E040FB" Offset="0.5"/>
                    <GradientStop Color="#15FFFFFF" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>

            <Grid>
                <!-- ═══ AMBIENT MULTI-POINT LIGHT FIELDS (Matching Reference Image 1) ═══ -->
                
                <!-- Light Field 1: Upper-Middle Soft Gray Diffuse Light -->
                <Ellipse Width="450" Height="140" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-40,0,0" IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                            <GradientStop Color="#309090A0" Offset="0"/>
                            <GradientStop Color="#15707080" Offset="0.45"/>
                            <GradientStop Color="#00000000" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <!-- Light Field 2: Lower-Right Subtle Silver Highlight -->
                <Ellipse Width="350" Height="120" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-50,-30" IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                            <GradientStop Color="#22A0A0B5" Offset="0"/>
                            <GradientStop Color="#00000000" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <!-- Light Field 3: Pink/Magenta Ambient Glow Bleeding from Mic into Glass (Audio-Reactive Target) -->
                <Ellipse x:Name="MicGlassBleedGlow" Width="300" Height="200" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-60,0,0,0" IsHitTestVisible="False" Opacity="0.65">
                    <Ellipse.Fill>
                        <RadialGradientBrush Center="0.4,0.5" GradientOrigin="0.4,0.5">
                            <GradientStop Color="#45FF52D9" Offset="0"/>
                            <GradientStop Color="#25D946EF" Offset="0.35"/>
                            <GradientStop Color="#10A855F7" Offset="0.65"/>
                            <GradientStop Color="#00000000" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <!-- TOP EDGE REFLECTION HIGHLIGHT -->
                <Border CornerRadius="28,28,0,0" Height="1" VerticalAlignment="Top" Margin="0,-18,0,0" IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#00FFFFFF" Offset="0"/>
                            <GradientStop Color="#40FFFFFF" Offset="0.5"/>
                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- TOP-RIGHT STATUS METADATA: 00:00 • Active -->
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal" Margin="0,-4,4,0">
                    <TextBlock x:Name="TimerText" Text="00:00" Foreground="#C0E040FB" FontSize="12" FontFamily="Segoe UI" FontWeight="SemiBold" Margin="0,0,8,0"/>
                    <Ellipse Width="6" Height="6" Fill="#10B981" VerticalAlignment="Center" Margin="0,0,5,0">
                        <Ellipse.Effect>
                            <DropShadowEffect BlurRadius="6" Color="#10B981" Direction="0" ShadowDepth="0" Opacity="0.9"/>
                        </Ellipse.Effect>
                    </Ellipse>
                    <TextBlock Text="Active" Foreground="#D094A3B8" FontSize="12" FontFamily="Segoe UI" FontWeight="Medium"/>
                </StackPanel>

                <!-- MAIN HORIZONTAL CONTENT FLOW: [MIC] -> [WAVEFORM] -> [TRANSCRIPTION GLASS CARD] -->
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>   <!-- Column 0: Large Mic Circle -->
                        <ColumnDefinition Width="150"/>    <!-- Column 1: Waveform -->
                        <ColumnDefinition Width="*"/>      <!-- Column 2: Speech Glass Panel -->
                    </Grid.ColumnDefinitions>

                    <!-- ═══ COLUMN 0: LUMINOUS PINK/MAGENTA AUDIO-REACTIVE MIC CONTROL ═══ -->
                    <Grid Grid.Column="0" VerticalAlignment="Center">
                        <!-- Outer Ambient Pink Neon Bloom (Audio-Reactive Target) -->
                        <Ellipse x:Name="MicOuterBloom" Width="145" Height="145" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.75" IsHitTestVisible="False">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="#C0FF47D6" Offset="0.10"/>
                                    <GradientStop Color="#70D946EF" Offset="0.40"/>
                                    <GradientStop Color="#30A855F7" Offset="0.70"/>
                                    <GradientStop Color="#00000000" Offset="1"/>
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>

                        <!-- Outer Neon Glow Ring 1 (Soft Pink Blur) -->
                        <Ellipse Width="128" Height="128" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.75" IsHitTestVisible="False">
                            <Ellipse.Stroke>
                                <SolidColorBrush Color="#FF52D9"/>
                            </Ellipse.Stroke>
                            <Ellipse.StrokeThickness>8</Ellipse.StrokeThickness>
                            <Ellipse.Effect>
                                <BlurEffect Radius="18"/>
                            </Ellipse.Effect>
                        </Ellipse>

                        <!-- Main Interactive Button Container -->
                        <Button x:Name="RecordBtn" Width="122" Height="122" Click="RecordBtn_Click" ToolTip="{DynamicResource Widget_ToggleRecordTip}" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid Width="122" Height="122">
                                        <!-- Main Neon Ring Border -->
                                        <Ellipse Width="122" Height="122" StrokeThickness="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Ellipse.Stroke>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#FF7AE5" Offset="0"/>
                                                    <GradientStop Color="#E040FB" Offset="0.30"/>
                                                    <GradientStop Color="#A855F7" Offset="0.65"/>
                                                    <GradientStop Color="#7C3AED" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Ellipse.Stroke>

                                            <!-- Luminous Multi-Layer Pink/Magenta Inner Atmosphere -->
                                            <Ellipse.Fill>
                                                <RadialGradientBrush Center="0.5,0.45" GradientOrigin="0.5,0.45">
                                                    <GradientStop Color="#FFFF67E8" Offset="0"/>       <!-- Bright pink center -->
                                                    <GradientStop Color="#D9FF52D9" Offset="0.25"/>    <!-- Luminous magenta -->
                                                    <GradientStop Color="#B0D946EF" Offset="0.50"/>    <!-- Violet transition -->
                                                    <GradientStop Color="#805B188F" Offset="0.75"/>    <!-- Deep purple -->
                                                    <GradientStop Color="#F0140C20" Offset="1"/>       <!-- Outer purple-black border -->
                                                </RadialGradientBrush>
                                            </Ellipse.Fill>
                                        </Ellipse>

                                        <!-- Audio-Reactive Inner Pink Atmosphere Overlay -->
                                        <Ellipse x:Name="MicInnerGlow" Width="114" Height="114" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.50" IsHitTestVisible="False">
                                            <Ellipse.Fill>
                                                <RadialGradientBrush Center="0.5,0.45">
                                                    <GradientStop Color="#FFFF6DED" Offset="0"/>
                                                    <GradientStop Color="#90FF52D9" Offset="0.45"/>
                                                    <GradientStop Color="#00000000" Offset="1"/>
                                                </RadialGradientBrush>
                                            </Ellipse.Fill>
                                        </Ellipse>

                                        <!-- Top Glass Reflection Highlight -->
                                        <Ellipse Width="110" Height="110" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.25" IsHitTestVisible="False">
                                            <Ellipse.Fill>
                                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                    <GradientStop Color="#FFFFFF" Offset="0"/>
                                                    <GradientStop Color="#00FFFFFF" Offset="0.5"/>
                                                </LinearGradientBrush>
                                            </Ellipse.Fill>
                                        </Ellipse>

                                        <!-- Crisp Luminous Mic Icon + REC Label -->
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0">
                                            <TextBlock Text="🎙️" FontSize="42" HorizontalAlignment="Center">
                                                <TextBlock.Effect>
                                                    <DropShadowEffect BlurRadius="16" Color="#FFFFFF" Direction="0" ShadowDepth="0" Opacity="0.95"/>
                                                </TextBlock.Effect>
                                            </TextBlock>
                                            <TextBlock x:Name="RecLabel" Text="REC" FontSize="11" FontWeight="Heavy" 
                                                       Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,2,0,0"
                                                       FontFamily="Segoe UI"/>
                                        </StackPanel>
                                    </Grid>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <!-- ═══ COLUMN 1: Audio-Reactive Glow Waveform Visualizer ═══ -->
                    <controls:GlowWaveformVisualizer x:Name="WaveVisualizer" Grid.Column="1" 
                                                      VerticalAlignment="Center" 
                                                      Height="65" 
                                                      Margin="10,0,10,0"/>

                    <!-- ═══ COLUMN 2: Inner Smoked Glass Speech / Transcription Card ═══ -->
                    <Grid Grid.Column="2" VerticalAlignment="Center">
                        <!-- Speech Bubble Pointer Triangle (Points left toward waveform) -->
                        <Path Data="M 0,15 L 12,0 L 12,30 Z" Fill="#A5262232" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="-10,0,0,0"/>

                        <!-- Speech Glass Card Box -->
                        <Border Background="#A5262232" 
                                BorderBrush="#35E040FB" 
                                BorderThickness="1.2" 
                                CornerRadius="20" 
                                Padding="18,14,18,14"
                                MinHeight="118">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="22" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.55"/>
                            </Border.Effect>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/> <!-- Header: Listening & Transcribing... -->
                                    <RowDefinition Height="*"/>    <!-- Live Transcript Text -->
                                    <RowDefinition Height="Auto"/> <!-- Bottom Actions: Copy / Close -->
                                </Grid.RowDefinitions>

                                <!-- Header Status Row -->
                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                    <TextBlock Text="Listening &amp; Transcribing..." 
                                               Foreground="#90E040FB" 
                                               FontSize="12" 
                                               FontWeight="Medium" 
                                               FontFamily="Segoe UI"/>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Ellipse Width="6" Height="6" Fill="#FF52D9" VerticalAlignment="Center" Margin="0,0,4,0">
                                            <Ellipse.Effect>
                                                <DropShadowEffect BlurRadius="6" Color="#FF52D9" Direction="0" ShadowDepth="0" Opacity="0.9"/>
                                            </Ellipse.Effect>
                                        </Ellipse>
                                        <TextBlock Text="Live" Foreground="#FF52D9" FontSize="11" FontWeight="Bold" FontFamily="Segoe UI"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Live Transcription Text -->
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,2,0,8">
                                    <TextBlock x:Name="TranscriptBox" 
                                               Text="{DynamicResource Widget_DefaultTranscript}" 
                                               Foreground="#FFFFFF" 
                                               FontSize="14" 
                                               FontWeight="SemiBold" 
                                               FontFamily="Segoe UI"
                                               TextWrapping="Wrap" 
                                               LineHeight="20"/>
                                </ScrollViewer>

                                <!-- Bottom Action Bar (Copy & Close) -->
                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button x:Name="CopyBtn" 
                                            Style="{StaticResource GlassCopyBtnStyle}"
                                            Click="CopyBtn_Click" 
                                            Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📋" FontSize="11" Margin="0,0,4,0"/>
                                            <TextBlock Text="{DynamicResource Widget_CopyBtn}" 
                                                       FontSize="11" FontWeight="SemiBold" 
                                                       Foreground="#FFFFFF" FontFamily="Segoe UI"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <Button x:Name="CloseWidgetBtn" 
                                            Style="{StaticResource GlassCloseBtnStyle}"
                                            Click="CloseWidgetBtn_Click"
                                            ToolTip="{DynamicResource Widget_CloseTip}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
