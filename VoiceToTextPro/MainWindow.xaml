<Window x:Class="VoiceToTextPro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:controls="clr-namespace:VoiceToTextPro.Controls"
        xmlns:tabs="clr-namespace:VoiceToTextPro.Tabs"
        TextElement.Foreground="{StaticResource MacTextPrimaryBrush}"
        TextElement.FontFamily="{StaticResource IranSansFont}"
        Background="{StaticResource MacBgDarkBrush}"
        Title="VoiceToText Pro"
        Height="730" Width="1200"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        MinHeight="580" MinWidth="900">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="8"
                      GlassFrameThickness="0" CornerRadius="14"/>
    </WindowChrome.WindowChrome>

    <!-- Outer rounded frame -->
    <Border CornerRadius="14" Background="{StaticResource MacBgDarkBrush}"
            BorderBrush="{StaticResource MacGlassBorderBrush}" BorderThickness="1"
            ClipToBounds="True">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="265"/> <!-- Glass Sidebar -->
                <ColumnDefinition Width="*"/>   <!-- Main Workspace -->
            </Grid.ColumnDefinitions>

            <!-- ═══════════════════════════════════════════════════════════
                 🏛 LEFT SIDEBAR — macOS Glass Navigation Panel
                 ═══════════════════════════════════════════════════════════ -->
            <Border Grid.Column="0"
                    Background="{StaticResource MacSidebarBgBrush}"
                    BorderBrush="{StaticResource MacGlassBorderBrush}"
                    BorderThickness="0,0,1,0">
                <Grid Margin="16,14,16,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Traffic Lights + Logo -->
                        <RowDefinition Height="Auto"/> <!-- Search -->
                        <RowDefinition Height="*"/>    <!-- Nav Items -->
                        <RowDefinition Height="Auto"/> <!-- Recent header -->
                        <RowDefinition Height="Auto"/> <!-- Quick actions -->
                        <RowDefinition Height="Auto"/> <!-- Engine status -->
                    </Grid.RowDefinitions>

                    <!-- 1. Traffic Lights + Brand -->
                    <Grid Grid.Row="0" Margin="0,0,0,20">
                        <!-- macOS Traffic Lights -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Top"
                                    Margin="0,0,0,14" WindowChrome.IsHitTestVisibleInChrome="True">
                            <Button Style="{StaticResource MacTrafficRedStyle}" Click="CloseWindow_Click"
                                    ToolTip="بستن" Margin="0,0,7,0" WindowChrome.IsHitTestVisibleInChrome="True"/>
                            <Button Style="{StaticResource MacTrafficYellowStyle}" Click="MinimizeWindow_Click"
                                    ToolTip="کوچک کردن" Margin="0,0,7,0" WindowChrome.IsHitTestVisibleInChrome="True"/>
                            <Button Style="{StaticResource MacTrafficGreenStyle}" Click="MaximizeWindow_Click"
                                    ToolTip="بزرگ کردن" WindowChrome.IsHitTestVisibleInChrome="True"/>
                        </StackPanel>

                        <!-- Brand Logo Row -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,38,0,0">
                            <Border CornerRadius="10" Width="36" Height="36" Margin="0,0,10,0"
                                    Background="{StaticResource MacAccentGradientBrush}"
                                    Effect="{StaticResource MacNeonGlowEffect}">
                                <TextBlock Text="LV" Foreground="White" FontWeight="Black"
                                           FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="VoiceToText Pro" FontSize="15" FontWeight="Black" Foreground="#FFFFFF"/>
                                <TextBlock Text="macOS Sonoma Studio" FontSize="10"
                                           Foreground="{StaticResource MacTextMutedBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- 2. Search Pill -->
                    <Border Grid.Row="1"
                            Background="{StaticResource MacInputBgBrush}"
                            BorderBrush="{StaticResource MacGlassBorderBrush}"
                            BorderThickness="1" CornerRadius="10"
                            Padding="10,7" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Magnify"
                                                     Foreground="{StaticResource MacTextMutedBrush}"
                                                     Width="15" Height="15" VerticalAlignment="Center"
                                                     Margin="0,0,8,0"/>
                            <TextBlock Text="{DynamicResource Search_Hint}" FontSize="12"
                                       Foreground="{StaticResource MacTextMutedBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- 3. Main Navigation -->
                    <ListBox x:Name="NavList" Grid.Row="2"
                             SelectionChanged="NavList_SelectionChanged"
                             Background="Transparent" BorderThickness="0"
                             SelectedIndex="0">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="11,9"/>
                                <Setter Property="Margin" Value="0,0,0,4"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd"
                                                    Background="Transparent"
                                                    CornerRadius="10"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#253045"/>
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource MacGlassBorderBrush}"/>
                                                    <Setter TargetName="Bd" Property="BorderThickness" Value="1"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#1E2736"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBoxItem Tag="0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="SquareEditOutline" Width="17" Height="17"
                                                         Foreground="{StaticResource MacPurpleBrush}"
                                                         VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="{DynamicResource Nav_AudioTranscribe}" FontSize="12.5"
                                           FontWeight="SemiBold" Foreground="#F1F5F9" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>

                        <ListBoxItem Tag="1">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Microphone" Width="17" Height="17"
                                                         Foreground="{StaticResource MacRedBrush}"
                                                         VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="{DynamicResource Nav_LiveTranscribe}" FontSize="12.5"
                                           FontWeight="SemiBold" Foreground="#F1F5F9" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>

                        <ListBoxItem Tag="2">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Subtitles" Width="17" Height="17"
                                                         Foreground="{StaticResource MacCyanBrush}"
                                                         VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="{DynamicResource Nav_SubtitleStudio}" FontSize="12.5"
                                           FontWeight="SemiBold" Foreground="#F1F5F9" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>

                        <ListBoxItem Tag="3">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CloudDownload" Width="17" Height="17"
                                                         Foreground="{StaticResource MacGreenBrush}"
                                                         VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="{DynamicResource Nav_MediaDownloader}" FontSize="12.5"
                                           FontWeight="SemiBold" Foreground="#F1F5F9" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>

                        <ListBoxItem Tag="4">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AccountVoice" Width="17" Height="17"
                                                         Foreground="{StaticResource MacPurpleBrush}"
                                                         VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="{DynamicResource Nav_TTS}" FontSize="12.5"
                                           FontWeight="SemiBold" Foreground="#F1F5F9" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>

                        <ListBoxItem Tag="5">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="RecordRec" Width="17" Height="17"
                                                         Foreground="{StaticResource MacGreenBrush}"
                                                         VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="{DynamicResource Nav_V2V}" FontSize="12.5"
                                           FontWeight="SemiBold" Foreground="#F1F5F9" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>

                    <!-- 4. Section label: Quick Actions -->
                    <TextBlock Grid.Row="3" Text="{DynamicResource Nav_Tools}" FontSize="10" FontWeight="Bold"
                               Foreground="{StaticResource MacTextMutedBrush}"
                               Margin="4,8,0,8"/>

                    <!-- 5. Action Buttons -->
                    <StackPanel Grid.Row="4" Margin="0,0,0,14">
                        <!-- Raycast Widget button -->
                        <Button Style="{StaticResource MacPillButtonStyle}" Click="RaycastWidgetBtn_Click"
                                Padding="14,9" Margin="0,0,0,8"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Microphone" Width="15" Height="15"
                                                         VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock Text="{DynamicResource Nav_FloatingWidget}" FontSize="12" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>

                        <!-- AI Models button -->
                        <Button Style="{StaticResource MacGhostButtonStyle}"
                                Click="OpenModelManagerFromAlert_Click"
                                Padding="14,9" Margin="0,0,0,0"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Brain" Width="15" Height="15"
                                                         VerticalAlignment="Center" Margin="0,0,7,0"
                                                         Foreground="{StaticResource MacCyanBrush}"/>
                                <TextBlock Text="{DynamicResource Nav_AiModels}" FontSize="12"
                                           Foreground="{StaticResource MacTextSecondaryBrush}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- 6. Engine Status Badge -->
                    <Border Grid.Row="5"
                            Background="{StaticResource MacHeaderBgBrush}"
                            CornerRadius="10" Padding="10,8"
                            BorderBrush="{StaticResource MacGlassBorderBrush}"
                            BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="StatusDot" Width="8" Height="8"
                                     Fill="{StaticResource MacGreenBrush}"
                                     Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="EngineStatusText"
                                           Text="{DynamicResource Status_EngineReady}"
                                           FontSize="11" Foreground="{StaticResource MacTextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="PythonVerText" Visibility="Collapsed" FontSize="10"
                                           Foreground="{StaticResource MacTextMutedBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- ═══════════════════════════════════════════════════════════
                 💻 RIGHT WORKSPACE — Dark Canvas + Header Controls
                 ═══════════════════════════════════════════════════════════ -->
            <Grid Grid.Column="1" Background="{StaticResource MacBgDarkBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header bar -->
                    <RowDefinition Height="Auto"/> <!-- Alert banner -->
                    <RowDefinition Height="*"/>    <!-- Tab content -->
                    <RowDefinition Height="Auto"/> <!-- Log drawer -->
                    <RowDefinition Height="Auto"/> <!-- Status bar -->
                </Grid.RowDefinitions>

                <!-- 1. Top Header Bar -->
                <Border Grid.Row="0"
                        Background="{StaticResource MacHeaderBgBrush}"
                        BorderBrush="{StaticResource MacGlassBorderBrush}"
                        BorderThickness="0,0,0,1" Padding="20,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="WorkspaceTitleText"
                                   Text="رونویسی فایل‌های صوتی"
                                   FontSize="17" FontWeight="Bold" Foreground="#FFFFFF"
                                   VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                    WindowChrome.IsHitTestVisibleInChrome="True">
                            <!-- Log toggle -->
                            <Button Style="{StaticResource MacGhostButtonStyle}"
                                    Click="ToggleLogDrawer_Click" Padding="10,6"
                                    Margin="0,0,8,0" Height="32">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Console" Width="14" Height="14"
                                                             VerticalAlignment="Center" Margin="0,0,5,0"
                                                             Foreground="{StaticResource MacTextSecondaryBrush}"/>
                                    <TextBlock Text="{DynamicResource Btn_Logs}" VerticalAlignment="Center" FontSize="11.5"
                                               Foreground="{StaticResource MacTextSecondaryBrush}"/>
                                    <Border x:Name="LogBadge" Background="{StaticResource MacPurpleBrush}"
                                            CornerRadius="8" Padding="5,1" Margin="6,0,0,0"
                                            Visibility="Collapsed">
                                        <TextBlock x:Name="LogCountText" Text="0"
                                                   Foreground="White" FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>
                            </Button>

                            <!-- Settings -->
                            <Button Style="{StaticResource MacGhostButtonStyle}"
                                    Click="Settings_Click" Padding="8,6" Height="32">
                                <materialDesign:PackIcon Kind="Settings" Width="15" Height="15"
                                                         Foreground="{StaticResource MacTextMutedBrush}"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 2. Dynamic Smart Alert Banner -->
                <Border x:Name="AlertBanner" Grid.Row="1"
                        Background="#2E1B1D" BorderBrush="{StaticResource MacRedBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="12,7"
                        Margin="16,10,16,0" Visibility="Collapsed"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="AlertCategoryBadge" Grid.Column="0"
                                Background="{StaticResource MacRedBrush}" CornerRadius="6"
                                Padding="8,3" Margin="0,0,10,0" VerticalAlignment="Center">
                            <TextBlock x:Name="AlertCategoryText" Text="خطا"
                                       Foreground="White" FontSize="11" FontWeight="Bold"/>
                        </Border>
                        <TextBlock x:Name="AlertText" Grid.Column="1" Text="خطایی رخ داده است."
                                   Foreground="#FCA5A5" FontSize="12" FontWeight="Medium"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <Button x:Name="AlertActionButton" Grid.Column="2" Click="AlertAction_Click"
                                Content="{DynamicResource Btn_Logs}" Height="26" Padding="10,0"
                                Background="{StaticResource MacRedBrush}" Foreground="White"
                                BorderThickness="0" FontWeight="Bold" FontSize="11"
                                Margin="12,0,8,0" Visibility="Visible" WindowChrome.IsHitTestVisibleInChrome="True">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="8"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Grid.Column="3" Click="DismissAlert_Click"
                                Width="24" Height="24" Background="Transparent"
                                BorderThickness="0" WindowChrome.IsHitTestVisibleInChrome="True">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent" CornerRadius="6"
                                            Padding="4">
                                        <materialDesign:PackIcon Kind="Close" Width="12" Height="12"
                                                                 Foreground="#FCA5A5"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- 3. Tab Views -->
                <TabControl x:Name="MainTabs" Grid.Row="2"
                            BorderThickness="0" Background="Transparent"
                            Padding="0">
                    <TabControl.ItemContainerStyle>
                        <Style TargetType="TabItem">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </Style>
                    </TabControl.ItemContainerStyle>
                    <TabItem>
                        <tabs:TranscribeTab x:Name="TranscribeTabCtrl"/>
                    </TabItem>
                    <TabItem>
                        <tabs:LiveTranscribeTab x:Name="LiveTranscribeTabCtrl"/>
                    </TabItem>
                    <TabItem>
                        <tabs:SubtitleTab x:Name="SubtitleTabCtrl"/>
                    </TabItem>
                    <TabItem>
                        <tabs:DownloaderTab x:Name="DownloaderTabCtrl"/>
                    </TabItem>
                    <TabItem>
                        <tabs:TTSTab x:Name="TTSTabCtrl"/>
                    </TabItem>
                    <TabItem>
                        <tabs:VoiceConverterTab x:Name="VoiceConverterTabCtrl"/>
                    </TabItem>
                </TabControl>

                <!-- 4. Log Drawer -->
                <Border x:Name="LogDrawer" Grid.Row="3"
                        Background="#0F141C"
                        BorderBrush="{StaticResource MacGlassBorderBrush}"
                        BorderThickness="0,1,0,0" Height="210"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Background="{StaticResource MacHeaderBgBrush}" Padding="14,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Logs_Header}" FontWeight="Bold" FontSize="12"
                                               Foreground="{StaticResource MacTextPrimaryBrush}" Margin="0,0,14,0"/>
                                    <RadioButton Content="{DynamicResource Logs_FilterAll}" IsChecked="True" Checked="LogFilter_Checked"
                                                 Tag="ALL" Margin="0,0,8,0"
                                                 Foreground="{StaticResource MacTextSecondaryBrush}" FontSize="11"/>
                                    <RadioButton Content="{DynamicResource Logs_FilterPython}" Checked="LogFilter_Checked"
                                                 Tag="PYTHON" Margin="0,0,8,0"
                                                 Foreground="{StaticResource MacTextSecondaryBrush}" FontSize="11"/>
                                    <RadioButton Content="{DynamicResource Logs_FilterErrors}" Checked="LogFilter_Checked"
                                                 Tag="ERROR"
                                                 Foreground="{StaticResource MacTextSecondaryBrush}" FontSize="11"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Button Style="{StaticResource MaterialDesignFlatButton}" Content="{DynamicResource Logs_BtnCopy}"
                                            Click="CopyLogs_Click" Foreground="{StaticResource MacTextMutedBrush}"
                                            Height="26" Padding="6,0" Margin="0,0,4,0"/>
                                    <Button Style="{StaticResource MaterialDesignFlatButton}" Content="{DynamicResource Logs_BtnSave}"
                                            Click="ExportLogs_Click" Foreground="{StaticResource MacTextMutedBrush}"
                                            Height="26" Padding="6,0" Margin="0,0,4,0"/>
                                    <Button Style="{StaticResource MaterialDesignFlatButton}" Content="{DynamicResource Logs_BtnClear}"
                                            Click="ClearLogs_Click" Foreground="{StaticResource MacRedBrush}"
                                            Height="26" Padding="6,0" Margin="0,0,8,0"/>
                                    <Button Style="{StaticResource MaterialDesignIconButton}"
                                            Click="ToggleLogDrawer_Click"
                                            Foreground="{StaticResource MacTextMutedBrush}" Width="26" Height="26">
                                        <materialDesign:PackIcon Kind="ChevronDown"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <ListView x:Name="LogListView" Grid.Row="1"
                                  Background="#0A0E17" BorderThickness="0"
                                  FontFamily="Consolas" FontSize="11">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="75"/>
                                            <ColumnDefinition Width="85"/>
                                            <ColumnDefinition Width="55"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding TimeFormatted}"
                                                   Foreground="{StaticResource MacTextMutedBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Source}"
                                                   Foreground="{StaticResource MacTextSecondaryBrush}"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="2" Text="{Binding LevelBadge}"
                                                   Foreground="{Binding ColorHex}" FontWeight="Bold"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Message}"
                                                   Foreground="{StaticResource MacTextPrimaryBrush}"
                                                   TextWrapping="Wrap" FlowDirection="LeftToRight"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <!-- 5. Status Footer -->
                <Border Grid.Row="4"
                        Background="{StaticResource MacHeaderBgBrush}"
                        BorderBrush="{StaticResource MacGlassBorderBrush}"
                        BorderThickness="0,1,0,0" Padding="16,5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="GlobalStatus"
                                   Text="{DynamicResource Status_GlobalReady}"
                                   FontSize="11" Foreground="{StaticResource MacTextMutedBrush}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="VoiceToText Pro v3.0"
                                   FontSize="10" Foreground="#374151" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
