<UserControl x:Class="VoiceToTextPro.Tabs.LiveTranscribeTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:VoiceToTextPro.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">

    <!-- ══ Root Viewport Grid: Concept Match ══ -->
    <Grid Margin="20,10,20,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title Header & Source Selector -->
            <RowDefinition Height="Auto"/> <!-- Centered Neon Waveform Visualizer -->
            <RowDefinition Height="Auto"/> <!-- Pill Control Bar (Pause, Stop, Discard) -->
            <RowDefinition Height="*"/>    <!-- Speaker Transcription Canvas -->
            <RowDefinition Height="Auto"/> <!-- Footer Actions -->
        </Grid.RowDefinitions>

        <!-- 1. Header Title & Device Selectors -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Title + Status Indicator -->
            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Live_Title}" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF"/>
                    <Border Background="#2B1D24" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="12" Padding="8,3" Margin="12,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon x:Name="StatusDotIcon" Kind="Circle" Width="10" Height="10" Foreground="#EF4444" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StatusTextBlock" Text="{DynamicResource Live_StatusStopped}" Foreground="#FCA5A5" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- Source & Device Selection Pill -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton x:Name="SystemAudioRadio" Content="🔊 System Audio" IsChecked="True" GroupName="AudioSourceGroup" 
                             Foreground="#E2E8F0" FontSize="11.5" Margin="0,0,12,0" Click="SourceRadio_Click" />
                <RadioButton x:Name="MicrophoneRadio" Content="🎙️ Microphone" GroupName="AudioSourceGroup" 
                             Foreground="#E2E8F0" FontSize="11.5" Margin="0,0,16,0" Click="SourceRadio_Click" />

                <ComboBox x:Name="DeviceComboBox" Width="170" Height="32" Padding="8,4" FontSize="11"
                          DisplayMemberPath="Name" Background="#1E2736" Foreground="White" Margin="0,0,8,0"/>
                <ComboBox x:Name="ModelComboBox" Width="140" Height="32" Padding="8,4" FontSize="11"
                          DisplayMemberPath="Name" Background="#1E2736" Foreground="White"/>
            </StackPanel>
        </Grid>

        <!-- 2. Centered Neon Waveform Visualizer (Exact Concept Match) -->
        <Border Grid.Row="1" Background="#131924" BorderBrush="{StaticResource MacGlassBorderBrush}" BorderThickness="1" CornerRadius="16" Height="110" Margin="0,0,0,16" Padding="12">
            <Grid>
                <controls:GlowWaveformVisualizer x:Name="GlowVisualizer" Height="90" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- 3. Floating Pill Control Bar (Pause, Stop, Discard) -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
            <!-- Start / Pause Button -->
            <Button x:Name="StartStopBtn" Click="StartStopBtn_Click" Height="36" Padding="18,0" Margin="0,0,12,0"
                    Style="{StaticResource MacPillButtonStyle}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon x:Name="StartStopIcon" Kind="PlayPause" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock x:Name="StartStopText" Text="{DynamicResource Live_StartBtn}" FontSize="12.5" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- Glowing Red Stop Pill -->
            <Button Click="StartStopBtn_Click" Style="{StaticResource MacRedGlowButtonStyle}" Height="36" Padding="20,0" Margin="0,0,12,0">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="10" Height="10" Fill="White" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource Live_StopBtn}" FontSize="12.5" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- Discard Button -->
            <Button Click="ClearCanvas_Click" Style="{StaticResource MaterialDesignOutlinedButton}" Height="36" Padding="14,0" Foreground="#94A3B8" BorderBrush="#334155">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="DeleteOutline" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="{DynamicResource Live_ClearBtn}" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- 4. Speaker Transcription Canvas (LexiVox Aesthetic) -->
        <Border Grid.Row="3" Background="#151B26" BorderBrush="{StaticResource MacGlassBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBox Grid.Row="0" x:Name="LiveCanvasTextBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         Background="Transparent" Foreground="#F1F5F9" FontSize="14.5" BorderThickness="0"
                         HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

                <!-- Live Interim Words Draft Bar -->
                <Border Grid.Row="1" Background="#1E2736" CornerRadius="10" Padding="12,8" Margin="0,12,0,0" BorderBrush="{StaticResource MacGlassBorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Kind="Waveform" Width="18" Height="18" Foreground="#06B6D4" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Grid.Column="1" x:Name="InterimDraftTextBlock" Text="..." Foreground="#38BDF8" FontSize="13" FontStyle="Italic" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- 5. Footer Actions Bar -->
        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <CheckBox x:Name="AutoScrollCheckBox" Content="{DynamicResource Live_AutoScroll}" IsChecked="True" Foreground="#94A3B8" FontSize="11.5" VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Click="CopyText_Click" Style="{StaticResource MaterialDesignOutlinedButton}" Height="30" Padding="12,0" Margin="0,0,8,0" Foreground="#CBD5E1" BorderBrush="#334155" FontSize="11">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ContentCopy" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock Text="{DynamicResource Live_CopyBtn}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Click="ExportText_Click" Style="{StaticResource MaterialDesignOutlinedButton}" Height="30" Padding="12,0" Foreground="#CBD5E1" BorderBrush="#334155" FontSize="11">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Download" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock Text="{DynamicResource Btn_Export}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
